# NVIDIA hosted services. Keep the real value in .env or your secret manager.
NVIDIA_API_KEY=

# Server-side Frappe API access. Never expose these values to the browser.
FRAPPE_BASE_URL=http://xwarehouse:8001
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Server-side Frappe API access. Never expose these values to the browser.
FRAPPE_BASE_URL=http://xwarehouse.localhost
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# OpenAI-compatible NVIDIA NIM LLM endpoint.
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Hosted Nemotron Speech settings.
NVIDIA_STT_LANGUAGE=en-US
NVIDIA_TTS_LANGUAGE=en-US
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
